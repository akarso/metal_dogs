# Copy into .env. Nothing loads this file.
# Upstream .env.example sets SHOPANDA_MEDIA_LOCAL_BASE_PATH=./public/media.
SHOPANDA_MEDIA_LOCAL_BASE_PATH=./var/media
# Required when media.storage=local and SHOPANDA_DEV_MODE is off (≥32 bytes).
# SHOPANDA_MEDIA_LOCAL_SIGN_SECRET=

# === Metal Dogs product plugin (plugins/metaldogs) ===
# Default false. When true: GET /api/customizer/enabled (not a k8s probe).
# An empty value (SHOPANDA_PLUGINS_METALDOGS_ENABLED=) disables the plugin
# even when YAML has plugins.metaldogs.enabled: true. Leave the variable unset to keep YAML.
# SHOPANDA_PLUGINS_METALDOGS_ENABLED=false

# Local compose (default password changeme; host port SHOPANDA_DATABASE_HOST_PORT or 5432):
# SHOPANDA_TEST_DSN=postgres://shopanda:changeme@127.0.0.1:5432/shopanda?sslmode=disable
